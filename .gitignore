# Generated from the dated edition files by `npm run brief` — each
# src/static/sports/brief/data/<date>.json is the source of truth, and the
# index is just the list of them. Never edit it by hand.
src/static/sports/brief/data/index.json

.DS_Store
*.log
npm-debug.log*

# Excel lock files, created while a workbook is open
~$*.xlsx
.~lock.*

# Claude Code local tool permissions — machine-specific, not project config.
# .claude/launch.json IS committed: it is the shared dev-server definition.
.claude/settings.local.json
