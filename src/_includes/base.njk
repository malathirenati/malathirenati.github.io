{% from "icons.njk" import icon %}<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="color-scheme" content="light dark">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">

{# Set the theme before first paint so a dark-mode reader never sees a light flash. #}
<script>
(function () {
  try {
    var t = localStorage.getItem("theme");
    if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>

<link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
{# The mark, downscaled at build time. A browser asks for this at 16-32px, so
   serving the 1200px original would cost every visitor 53KB for a 16px slot.
   The SVG is kept as the first choice for browsers that take it: it stays sharp
   at any size, where a 32px raster does not. #}
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/favicon-32.png' | url }}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{ '/assets/apple-touch-icon.png' | url }}">
</head>
<body data-repo="{{ site.repo }}">

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' | url }}">
      {# Falls back to the initials block if the logo file is ever missing, so a
         bad path degrades to something legible rather than to a gap. #}
      {% if site.logo %}
        <img class="brand-logo" src="{{ site.logo | url }}" alt="" width="240" height="240"
             decoding="async">
      {% else %}
        <span class="brand-mark" aria-hidden="true">{{ site.shortMark }}</span>
      {% endif %}
      <span>{{ site.title }}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {# Top level: one entry per section. A section is "current" for every page
         beneath it, so /sports/timeline/ still highlights Sport. #}
      <a href="{{ '/' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a>
      {% for s in site.sections %}
        {% if s.external %}
          {# An off-site section — the podcast archive lives on its own host.
             rel="noopener" because target="_blank" otherwise hands the new tab a
             window.opener reference back to this page. #}
          <a class="nav-ext" href="{{ s.url }}" target="_blank" rel="noopener">
            {{ s.title }}<span class="visually-hidden"> (opens in a new tab)</span>{{ icon("external") }}
          </a>
        {% else %}
          <a href="{{ s.url | url }}"
             {% if page.url.startsWith(s.url) %}aria-current="page"{% endif %}>{{ s.title }}</a>
        {% endif %}
      {% endfor %}

      <button type="button" class="theme-toggle" id="theme-toggle"
              aria-label="Switch between light and dark theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.3 8.3 0 1 0 20 14.5Z"/>
        </svg>
      </button>
    </nav>
  </div>
</header>

{% if banner and site.banner %}
{# Art direction, not one image scaled: a 4:1 crop is right on a desktop and
   only ~94px tall on a 375px phone, so phones get a 2.23:1 crop of the same
   artwork instead. Both carry width/height so each reserves its own space and
   the page below never jumps — the aspect ratio differs per source, which is
   exactly why the attributes have to sit on the <source> as well as the <img>.
   Opted into per page via `banner: true` in front matter. #}
<div class="site-banner">
  <picture>
    <source media="(min-width: 700px)" srcset="{{ site.banner.wide | url }}"
            width="2400" height="685">
    <img src="{{ site.banner.tall | url }}" alt="" width="1400" height="699"
         decoding="async" fetchpriority="high">
  </picture>
</div>
{% endif %}

<main id="main">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <span>&copy; {{ "" | year }} {{ site.author }}</span>
    <span>Built as a static site — no trackers, no cookies.</span>
  </div>
</footer>

<script>
(function () {
  var btn = document.getElementById("theme-toggle");
  if (!btn) return;
  btn.addEventListener("click", function () {
    var root = document.documentElement;
    var current = root.getAttribute("data-theme");
    if (!current) {
      // Following the OS so far — flip to the opposite of what is showing.
      current = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    var next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    window.dispatchEvent(new CustomEvent("themechange", { detail: { theme: next } }));
  });
})();
</script>

<script>
/* Contact link. The address is assembled from two data attributes and written
   to the href once, on load, so it is never a complete string in the served
   HTML — the protection the old "user [at] domain" text gave — while the link
   itself behaves like any other mailto: for the browser and the OS.

   Setting href beats handling click and assigning location.href: that
   assignment is silently discarded when no mail client is registered, so the
   control reads as broken. A real href also supports right-click, copy address
   and open-in-new-tab. */
(function () {
  var el = document.getElementById("email-btn");
  if (!el) return;
  var u = el.getAttribute("data-u"), d = el.getAttribute("data-d");
  if (!u || !d) return;
  el.setAttribute("href", "mailto:" + u + String.fromCharCode(64) + d);
})();
</script>

{% block scripts %}{% endblock %}
</body>
</html>
