{#
  Inline SVG icons.

  Inline rather than an icon font or a CDN sprite: no extra request, no
  third-party dependency, and they take `currentColor`, so the dark theme needs
  no second set. All draw on a 24x24 grid so every pill gets identical geometry.

  Usage:  {% from "icons.njk" import icon %}  ...  {{ icon("linkedin") }}
#}

{% macro icon(name) %}
{%- if name == "linkedin" -%}
<svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.2h4V21H3V9.2Zm7 0h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.35c0-1.28-.02-2.92-1.83-2.92-1.83 0-2.11 1.38-2.11 2.83V21h-4V9.2Z"/>
</svg>
{%- elif name == "medium" -%}
<svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  <ellipse cx="6.55" cy="12" rx="6.55" ry="6.2"/>
  <ellipse cx="17.1" cy="12" rx="3.3" ry="5.85"/>
  <ellipse cx="22.6" cy="12" rx="1.2" ry="5.2"/>
</svg>
{%- elif name == "substack" -%}
<svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  <path d="M3 3h18v2.65H3V3Zm0 4.6h18v2.65H3V7.6Zm0 4.6h18V21l-9-5.05L3 21v-8.8Z"/>
</svg>
{%- elif name == "instagram" -%}
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="3" y="3" width="18" height="18" rx="5.2"/>
  <circle cx="12" cy="12" r="4"/>
  <circle cx="17.3" cy="6.7" r="1.05" fill="currentColor" stroke="none"/>
</svg>
{%- elif name == "mic" -%}
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="9" y="2.4" width="6" height="11.2" rx="3"/>
  <path d="M5.4 11.1a6.6 6.6 0 0 0 13.2 0M12 17.7V21.2M8.6 21.2h6.8"/>
</svg>
{%- elif name == "mail" -%}
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/>
  <path d="M3 6.5l9 6.2 9-6.2"/>
</svg>
{%- elif name == "external" -%}
{# Trailing marker on a link that leaves the site. aria-hidden because the
   surrounding link already says "opens in a new tab" to a screen reader. #}
<svg class="ico ico-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d="M14 4h6v6M20 4l-8.5 8.5"/>
  <path d="M18 14.5V19a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V8a1.5 1.5 0 0 1 1.5-1.5H10"/>
</svg>
{%- endif -%}
{% endmacro %}


{#
  A section's mark, shown beside a page title and on the home page cards.
  One macro so the treatment — size, the light plate the dark theme needs,
  the empty-state — is identical everywhere it appears.
#}
{% macro sectionLogo(src, alt, size = "md") %}
{%- if src -%}
<img class="seclogo seclogo-{{ size }}" src="{{ src | url }}" alt="{{ alt }}"
     width="240" height="240" loading="lazy" decoding="async">
{%- endif -%}
{% endmacro %}
